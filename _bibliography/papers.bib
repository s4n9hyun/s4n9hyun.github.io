@article{choi2026epilog,
  title     = {{EPILOG}: An Integrated Genotype--Phenotype--Function Database for Epilepsy-Associated Variants Incorporating a {Korean} Patient Cohort},
  author    = {Choi*, Won Jong and Lee*, Sanghyun and Chung, Dae Sun and Cho, Jaeso and Kim†, Kwangsoo and Hong, Dongwan and Yang, Sunah and Lim†, Byung Chan and Park†, Jongkeun},
  journal   = {Database},
  year      = {2026},
  abbr      = {Database},
  additional_info = {, under review},
  annotation = {* Equal contribution, † Corresponding author},
  website   = {https://epilog.info/},
  abstract  = {Genetic epilepsy involves a wide range of genes, variants, and clinical manifestations. Although genomic sequencing has improved variant detection, its interpretation remains difficult because clinical observations, functional studies, protein structures, and computational predictions are distributed across separate resources. We developed EPILOG (EPILepsy solution On Genome data portal), a web-based database that combines data across resources for 13 epilepsy-associated genes. EPILOG integrates 12,122 literature-derived patient records with clinical and genetic data from 148 Korean patients recruited from six medical institutions, together with standardized variant annotations, population frequencies, clinical phenotypes, treatment responses, published electrophysiological findings, pathogenicity and functional-direction predictions, and comparative analyses of AlphaFold 3 wild-type and variant structures. A variant-centered interface lets users inspect the underlying evidence while preserving the distinctions between evidence types, supporting the investigation of genotype--phenotype--function relationships in genetic epilepsies.},
  bibtex_show = {true}
}

@inproceedings{lee2026palc,
  title     = {{PALC}: Preference Alignment via Logit Calibration},
  author    = {Lee, Sanghyun and In, Hoh Peter},
  booktitle = {The Fourteenth International Conference on Learning Representations (ICLR)},
  year      = {2026},
  abbr      = {ICLR},
  url       = {https://openreview.net/forum?id=0cmuYj3WeG},
  html      = {https://openreview.net/forum?id=0cmuYj3WeG},
  pdf       = {https://openreview.net/pdf?id=0cmuYj3WeG},
  abstract  = {Aligning Large Language Models with human preferences typically requires computationally intensive training or complex reward architectures. We introduce PALC (Preference Alignment via Logit Calibration), a parameter-efficient framework that achieves test-time alignment through a novel intervention strategy: direct calibration in vocabulary space. Unlike existing methods that manipulate entangled hidden representations or rely on external reward models, PALC operates at the logit layer where each dimension corresponds to a distinct token, providing interpretable and efficient control. Our approach employs a bottleneck architecture that learns to compress the base model's hidden states and generate position-dependent calibration vectors, requiring only a fraction of the base model's parameters. Through this design, PALC sidesteps the superposition problem inherent in representation engineering while eliminating the computational overhead of guided decoding methods. A single scaling factor enables runtime adjustment of alignment strength without retraining, allowing practitioners to balance between preserving model capabilities and enforcing preferences. Experiments demonstrate that PALC outperforms most test-time alignment methods while maintaining near-baseline inference speed. Our ablations reveal that human preferences concentrate on surprisingly low-dimensional manifolds, validating our architectural choices. By establishing vocabulary-space intervention as an effective alignment paradigm, PALC makes preference alignment accessible for resource-constrained deployments where traditional methods are infeasible, opening new avenues for scalable and adaptive AI alignment.},
  selected  = {true},
  bibtex_show = {true}
}

---
layout: default
---
{% comment %}
  About page with a profile sidebar: left column on desktop, stacked on top on mobile.
  Sidebar fields come from `page.sidebar` in _pages/about.md.
{% endcomment %}
{% assign sb = page.sidebar %}
<div class="post about-with-sidebar">
  <div class="about-layout">
    <aside class="about-sidebar">
      <div class="about-sidebar-inner">
        {% if sb.image %}
          <img class="about-avatar" src="{{ sb.image | prepend: '/assets/img/' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}">
        {% else %}
          <div class="about-avatar about-avatar-placeholder" aria-hidden="true">{{ site.first_name | slice: 0 }}{{ site.last_name | slice: 0 }}</div>
        {% endif %}
        <h1 class="about-name">{{ site.first_name }} {{ site.last_name }}</h1>
        {% if sb.bio %}<p class="about-bio">{{ sb.bio }}</p>{% endif %}
        <ul class="about-links">
          {% if sb.location %}<li><i class="fa-solid fa-location-dot fa-fw"></i> {{ sb.location }}</li>{% endif %}
          {% if sb.affiliation %}<li><i class="fa-solid fa-building-columns fa-fw"></i> {{ sb.affiliation }}</li>{% endif %}
          {% if sb.email %}<li><a href="mailto:{{ sb.email }}"><i class="fa-solid fa-envelope fa-fw"></i> Email</a></li>{% endif %}
          {% if sb.github %}<li><a href="https://github.com/{{ sb.github }}" target="_blank" rel="noopener"><i class="fa-brands fa-github fa-fw"></i> GitHub</a></li>{% endif %}
          {% if sb.cv %}<li><a href="{{ sb.cv | relative_url }}" target="_blank" rel="noopener"><i class="fa-solid fa-file-pdf fa-fw"></i> CV</a></li>{% endif %}
        </ul>
      </div>
    </aside>

    <article class="about-main">
      <div class="clearfix">{{ content }}</div>

      {% if page.latest_posts and page.latest_posts.enabled %}
        <h2><a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a></h2>
        {% include latest_posts.liquid %}
      {% endif %}

      {% if page.selected_papers %}
        <h2><a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a></h2>
        {% include selected_papers.liquid %}
      {% endif %}
    </article>
  </div>
</div>
